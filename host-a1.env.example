# Copie somente os valores desejados para o .env gerado pelo deploy.sh.
# Nao coloque chaves reais neste arquivo versionado.

# Versao atual com correcoes de reconexao, WebSocket e VP9. Para rollback:
# livekit/livekit-server:v1.13.5
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.6
MAZESTREAM_BUILD_PROFILE=host

# Vazio: a API administrativa segue PUBLIC_WSS_URL (wss:// -> https://).
# Endereco interno e opcional e exige conectividade do container ate o LiveKit.
LIVEKIT_API_URL=

# Limites iniciais para uma VM A1 com 2 CPUs compartilhada por outros projetos.
MAZESTREAM_LIVEKIT_CPUS=1.25
MAZESTREAM_LIVEKIT_MEMORY=1536m
MAZESTREAM_REDIS_CPUS=0.10
MAZESTREAM_REDIS_MEMORY=192m
MAZESTREAM_FRONTEND_CPUS=0.20
MAZESTREAM_FRONTEND_MEMORY=256m
MAZESTREAM_DISCORD_CPUS=0.05
MAZESTREAM_DISCORD_MEMORY=128m

# Protecao de capacidade. Ajuste somente depois de um load test fora do servidor.
MAX_ROOMS=2
MAX_PARTICIPANTS_PER_ROOM=10
TOKENS_POR_SEG=20
# Arquivos temporarios: limites de dados em memoria, quantidade e concorrencia.
SHARE_MAX_MB=8
SHARE_TOTAL_MB=32
SHARE_TTL_MIN=60
SHARE_MAX_FILES=128
SHARE_MAX_UPLOADS=2
SHARE_UPLOADS_PER_MINUTE=6
ALERTA_MBPS=120
BANDWIDTH_INTERVAL_SECONDS=30
BANDWIDTH_ALERT_COOLDOWN_MINUTES=10
