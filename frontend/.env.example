# === Mazestream Frontend - Variaveis de Ambiente ===
#
# Copie este arquivo para .env e ajuste os valores.
# Para rodar local com `npm run dev:full`, nenhuma env e obrigatoria
# (o dev-server.cjs usa valores padrao para testes locais).
#
# Para producao (server.cjs), LIVEKIT_API_KEY e LIVEKIT_API_SECRET sao obrigatorios.

# Chave API do LiveKit (obrigatorio em producao, opcional em dev)
# LIVEKIT_API_KEY=devkey

# Segredo da API do LiveKit (obrigatorio em producao, opcional em dev)
# LIVEKIT_API_SECRET=devsecret

# URL WebSocket do LiveKit (ex: wss://seudominio ou ws://localhost:7880)
# Em dev, padrao: ws://localhost:7880
# PUBLIC_WSS_URL=ws://localhost:7880

# URL HTTP da API do LiveKit (opcional, deriva do WSS_URL por padrao)
# LIVEKIT_API_URL=http://localhost:7880

# Porta do servidor (producao usa 3000, dev usa 3001)
# PORT=3001

# Maximo de salas simultaneas (producao)
# MAX_ROOMS=5

# Limite de tokens por segundo (producao)
# TOKENS_POR_SEG=40

# Webhook Discord para alertas de banda (producao, opcional)
# ALERTA_WEBHOOK=
# ALERTA_MBPS=250
# BITRATE_MBPS=6
