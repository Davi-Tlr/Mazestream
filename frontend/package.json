{
  "name": "@mazestream/web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:token": "node --env-file-if-exists=.env dev-server.cjs",
    "dev:full": "concurrently --kill-others -n server,vite -c blue,green \"node --env-file-if-exists=.env dev-server.cjs\" \"vite\"",
    "build": "vite build && node scripts/precompress.cjs",
    "build:host": "vite build --mode host-a1 && node scripts/precompress.cjs",
    "build:local": "vite build --mode local-preview && node scripts/precompress.cjs",
    "test": "node --test src/*.test.js server.integration.test.cjs",
    "preview": "vite preview",
    "dev:host": "vite --mode host-a1",
    "dev:local": "vite --mode local-preview"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "framer-motion": "^11.18.2",
    "konva": "^10.3.1",
    "livekit-client": "2.22.1",
    "mediabunny": "^1.52.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "^18.2.16"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.1.2",
    "vite": "7.3.6"
  }
}
