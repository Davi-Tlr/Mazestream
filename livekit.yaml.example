# Exemplo de configuracao.
# O deploy.sh gera livekit.yaml automaticamente.

port: 7880

rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true

redis:
  address: localhost:6379

keys:
  SUA_API_KEY: SEU_API_SECRET

turn:
  enabled: true
  domain: livekit.exemplo.com
  udp_port: 3478

logging:
  level: info
  json: false
